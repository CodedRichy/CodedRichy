# Last.fm — copy to .env and fill in. .env is gitignored.
#
# LASTFM_API_KEY is NOT a secret in the usual sense: the widget runs in the
# browser, so whatever key it uses is readable by any visitor. Keeping it out
# of git only stops it being scraped from the repo and lets you rotate it
# without rewriting history.
#
# LASTFM_SHARED_SECRET is a real secret. It is only needed for write methods
# (scrobble, love) which this site does not use. Do not put it here, in the
# repo, or in any client file.

LASTFM_API_KEY=
LASTFM_USER=
